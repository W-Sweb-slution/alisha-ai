PORT=3000
HOST=0.0.0.0
# Render: NODE_ENV=production, TRUST_PROXY=1. Local HTTP: leave NODE_ENV unset.
N8N_ENVIRONMENT=test
# Copy the existing server-only webhook values into your private environment.
ALISA_CHAT_WEBHOOK=
N8N_WEBHOOK_URL=

# Required for signed server-side sessions. Generate a unique random value for each deployment.
SESSION_SECRET=
# Optional persistent SQLite path (defaults to ./data/alisha-auth.sqlite)
AUTH_DB_PATH=data/alisha-auth.sqlite
# Render: /var/data/alisha-auth.sqlite on the mounted persistent disk.
# Set true on Render to refuse accidental creation of an empty database.
AUTH_DB_REQUIRE_EXISTING=false
# Only npm run start:render uses this first-deploy maintenance switch.
# Keep true until the existing SQLite file is installed; then set false.
RENDER_MAINTENANCE_MODE=false
# Set to 1 only when exactly one trusted reverse proxy is in front of Express
TRUST_PROXY=0

# Google Sheets OAuth (server-side only)
ALISHA_ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_SPREADSHEET_ID=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Social account OAuth (all values are server-side only)
# Generate a separate 32-byte key for social provider tokens; do not reuse the Google key.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Meta app is shared by Facebook and Instagram account authorization.
META_APP_ID=
META_APP_SECRET=
# Register this callback in the Meta developer app; use HTTPS outside localhost.
META_REDIRECT_URI=http://localhost:3000/api/social-accounts/oauth/callback
META_GRAPH_API_VERSION=v23.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/social-accounts/oauth/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok Login Kit web redirect URIs require HTTPS; configure a registered secure callback.
TIKTOK_REDIRECT_URI=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/social-accounts/oauth/callback

# Keep false until the updated n8n workflow and a real Facebook Page publish test are verified.
N8N_ACCOUNT_AWARE_PUBLISHING_ENABLED=false
# Shared secret used by n8n for per-account dispatch and status callbacks (at least 32 random characters).
N8N_PUBLISHING_CALLBACK_SECRET=
